generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SOCIO
}

enum Genero {
  MACHO
  FEMEA
}

enum StatusAnimal {
  VIVO
  MORTO
  VENDIDO
}

enum TipoSanitario {
  VACINA
  MEDICAMENTO
}

enum StatusReprodutivo {
  CHEIA
  VAZIA
  PARIDA
  BEZERRO_NO_PE
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(SOCIO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  animais              Animal[]
  mortesRegistradas    Morte[]            @relation("RegistradoPor")
  reproducoes          ReproducaoAnimal[] @relation("RegistroReproducao")
}

model Animal {
  id             Int          @id @default(autoincrement())
  numero         String?
  genero         Genero
  eraMes         Int?
  eraAno         Int?
  peso           Float?
  reprodutor     Boolean      @default(false)
  status         StatusAnimal @default(VIVO)
  denominacao   String
  observacoes    String?
  fotoUrl        String?
  dataVenda      DateTime?
  proprietarioId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  proprietario        User                @relation(fields: [proprietarioId], references: [id])
  morte               Morte?
  registrosSanitarios RegistroSanitario[]
  reproducoes         ReproducaoAnimal[]

  @@index([proprietarioId])
  @@index([status])
  @@index([denominacao])
}

model ClassificacaoConfig {
  id              Int      @id @default(autoincrement())
  denominacao     String   @unique
  genero          Genero
  idadeMinMeses   Int
  idadeMaxMeses   Int?
  ordem           Int
  updatedAt       DateTime @updatedAt
}

model Morte {
  id            Int      @id @default(autoincrement())
  animalId      Int      @unique
  dataObito     DateTime
  causa         String?
  observacoes   String?
  registradoPorId Int
  createdAt     DateTime @default(now())

  animal        Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  registradoPor User   @relation("RegistradoPor", fields: [registradoPorId], references: [id])
}

model RegistroSanitario {
  id          Int           @id @default(autoincrement())
  animalId    Int
  tipo        TipoSanitario
  produto     String
  data        DateTime
  dose        String?
  observacoes String?
  createdAt   DateTime      @default(now())

  animal      Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@index([data])
}

model CausaMortePredefinida {
  id    Int     @id @default(autoincrement())
  nome  String  @unique
  ativo Boolean @default(true)
  ordem Int     @default(0)
}

model ConfigGlobal {
  id        Int      @id @default(autoincrement())
  chave     String   @unique
  valor     String
  updatedAt DateTime @updatedAt
}

model EstacaoMonta {
  id         Int      @id @default(autoincrement())
  nome       String
  dataInicio DateTime
  dataFim    DateTime
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())

  reproducoes ReproducaoAnimal[]
}

model Semen {
  id      Int     @id @default(autoincrement())
  codigo  String  @unique
  touro   String?
  ativo   Boolean @default(true)
  ordem   Int     @default(0)

  reproducoes ReproducaoAnimal[]
}

model ReproducaoAnimal {
  id                Int                @id @default(autoincrement())
  animalId          Int
  statusReprodutivo StatusReprodutivo?
  dataToque         DateTime?
  estacaoMontaId    Int?
  inseminada        Boolean            @default(false)
  dataInseminacao   DateTime?
  semenId           Int?
  observacoes       String?
  registradoPorId   Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  animal        Animal        @relation(fields: [animalId], references: [id], onDelete: Cascade)
  estacaoMonta  EstacaoMonta? @relation(fields: [estacaoMontaId], references: [id])
  semen         Semen?        @relation(fields: [semenId], references: [id])
  registradoPor User          @relation("RegistroReproducao", fields: [registradoPorId], references: [id])

  @@index([animalId])
  @@index([estacaoMontaId])
  @@index([statusReprodutivo])
}
