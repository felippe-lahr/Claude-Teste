generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusLote {
  ABERTO
  EM_NEGOCIACAO
  VENDIDO
}

enum Role {
  ADMIN
  SOCIO
}

enum Genero {
  MACHO
  FEMEA
}

enum StatusAnimal {
  VIVO
  MORTO
  VENDIDO
}

enum TipoSanitario {
  VACINA
  MEDICAMENTO
}

enum StatusReprodutivo {
  CHEIA
  VAZIA
}

enum EstagioPrenhez {
  P1
  P2
  P3
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(SOCIO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  animais              Animal[]
  mortesRegistradas    Morte[]            @relation("RegistradoPor")
  reproducoes          ReproducaoAnimal[] @relation("RegistroReproducao")
  logs                 LogAlteracao[]
  lotesCriados         LoteAnimal[]
}

model Animal {
  id             Int          @id @default(autoincrement())
  numero         String?
  genero         Genero
  eraMes         Int?
  eraAno         Int?
  peso           Float?
  reprodutor     Boolean      @default(false)
  descarte       Boolean      @default(false)
  status         StatusAnimal @default(VIVO)
  denominacao   String
  observacoes    String?
  fotoUrl        String?
  dataVenda      DateTime?
  proprietarioId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  proprietario        User                @relation(fields: [proprietarioId], references: [id])
  morte               Morte?
  registrosSanitarios RegistroSanitario[]
  reproducoes         ReproducaoAnimal[]
  loteItems           LoteAnimalItem[]

  @@index([proprietarioId])
  @@index([status])
  @@index([denominacao])
}

model ClassificacaoConfig {
  id              Int      @id @default(autoincrement())
  denominacao     String   @unique
  genero          Genero
  idadeMinMeses   Int
  idadeMaxMeses   Int?
  ordem           Int
  updatedAt       DateTime @updatedAt
}

model Morte {
  id            Int      @id @default(autoincrement())
  animalId      Int      @unique
  dataObito     DateTime
  causa         String?
  observacoes   String?
  registradoPorId Int
  createdAt     DateTime @default(now())

  animal        Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  registradoPor User   @relation("RegistradoPor", fields: [registradoPorId], references: [id])
}

model RegistroSanitario {
  id          Int           @id @default(autoincrement())
  animalId    Int
  tipo        TipoSanitario
  produto     String
  data        DateTime
  dose        String?
  observacoes String?
  createdAt   DateTime      @default(now())

  animal      Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@index([data])
}

model CausaMortePredefinida {
  id    Int     @id @default(autoincrement())
  nome  String  @unique
  ativo Boolean @default(true)
  ordem Int     @default(0)
}

model ConfigGlobal {
  id        Int      @id @default(autoincrement())
  chave     String   @unique
  valor     String
  updatedAt DateTime @updatedAt
}

model EstacaoMonta {
  id         Int      @id @default(autoincrement())
  nome       String
  dataInicio DateTime
  dataFim    DateTime
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())

  reproducoes ReproducaoAnimal[]
}

model Semen {
  id      Int     @id @default(autoincrement())
  codigo  String  @unique
  touro   String?
  ativo   Boolean @default(true)
  ordem   Int     @default(0)

  reproducoes ReproducaoAnimal[]
}

model ClassificacaoPrenhezConfig {
  id        Int    @id @default(autoincrement())
  estagio   String @unique  // "P1", "P2", "P3"
  label     String          // "P1 (0–3 meses)"
  mesInicio Int             // 0, 3, 6
  mesFim    Int             // 2, 5, 8
  ordem     Int             @default(0)
}

model ReproducaoAnimal {
  id                Int                @id @default(autoincrement())
  animalId          Int
  statusReprodutivo StatusReprodutivo?
  estagioPrenhez    EstagioPrenhez?
  dataToque         DateTime?
  estacaoMontaId    Int?
  inseminada        Boolean            @default(false)
  dataInseminacao   DateTime?
  semenId           Int?
  montaNatural      Boolean            @default(false)
  dataMontaNatural  DateTime?
  ultimoPartoMes    Int?
  ultimoPartoAno    Int?
  nuncaPariu        Boolean            @default(false)
  observacoes       String?
  registradoPorId   Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  animal        Animal        @relation(fields: [animalId], references: [id], onDelete: Cascade)
  estacaoMonta  EstacaoMonta? @relation(fields: [estacaoMontaId], references: [id])
  semen         Semen?        @relation(fields: [semenId], references: [id])
  registradoPor User          @relation("RegistroReproducao", fields: [registradoPorId], references: [id])

  @@index([animalId])
  @@index([estacaoMontaId])
  @@index([statusReprodutivo])
}

model LogAlteracao {
  id           Int      @id @default(autoincrement())
  tipo         String   // IMPORTACAO | CADASTRO | EDICAO | EXCLUSAO | REPRODUCAO | SANITARIO | LOTE
  animalId     Int?
  animalNumero String?
  proprietario String?
  descricao    String
  userId       Int
  userName     String
  origem       String?  // "Manual" | "Importação: arquivo.xlsx" | "Lote"
  fileHash     String?  // SHA-256 of imported file (anti-duplicate check)
  fileName     String?
  importTotal  Int?
  importErros  Int?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([tipo])
  @@index([animalId])
  @@index([createdAt])
  @@index([fileHash])
}

model LoteAnimal {
  id             Int        @id @default(autoincrement())
  nome           String
  status         StatusLote @default(ABERTO)
  dataFechamento DateTime?
  comprador      String?
  valorTotal     Float?
  pesoTotal      Float?
  notaFiscal     String?
  gta            String?
  observacoes    String?
  criadoPorId    Int
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  criadoPor User           @relation(fields: [criadoPorId], references: [id])
  animais   LoteAnimalItem[]

  @@index([status])
  @@index([criadoPorId])
}

model LoteAnimalItem {
  id       Int @id @default(autoincrement())
  loteId   Int
  animalId Int

  lote   LoteAnimal @relation(fields: [loteId], references: [id], onDelete: Cascade)
  animal Animal     @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@unique([loteId, animalId])
  @@index([animalId])
}
